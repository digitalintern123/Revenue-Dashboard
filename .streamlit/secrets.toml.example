# .streamlit/secrets.toml.example
# Copy this to secrets.toml and fill in your own values.
# NEVER commit secrets.toml to git.
# Run: python modules/generate_password_hash.py  to generate password hashes.

# ── Authentication ───────────────────────────────────────────────────────────
[auth]

[auth.users]
# Add one line per user: username = "salt$pbkdf2:hash"
# Generate with: python modules/generate_password_hash.py
admin = "<salt>$<hash>"
viewer = "<salt>$<hash>"

[auth.admins]
# Usernames listed here get access to the Reset Database danger zone.
# Leave empty to disable admin access for everyone (recommended default).
# Example: admins = ["admin"]
admins = []

# ── Database ─────────────────────────────────────────────────────────────────
# Required for production — without this, data is lost on every restart.
DATABASE_URL = "postgresql://encalm_user:Encalm@2026@localhost:5432/encalm_analytics"

# ── Upload limits ────────────────────────────────────────────────────────────
# Max revenue uploads per user per hour (default: 20)
# MAX_UPLOADS_PER_HOUR = 20
