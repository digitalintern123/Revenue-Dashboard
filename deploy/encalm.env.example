# Copy to /var/www/vhosts/YOUR-DOMAIN.COM/private/encalm.env  (chmod 600)
# Read by encalm.service. Never commit the real file.

# PostgreSQL on this VPS (no SSL needed on localhost)
DATABASE_URL=postgresql://encalm:CHANGE-THIS-PASSWORD@127.0.0.1:5432/encalm

# Where app logs/backups that are not in git may go (optional)
# DATA_DIR=/var/www/vhosts/YOUR-DOMAIN.COM/private/data
